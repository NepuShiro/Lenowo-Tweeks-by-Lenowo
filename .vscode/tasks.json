{
	"version": "2.0.0",
	"tasks": [
		{
            "label": "build Debug",
            "command": "dotnet",
            "type": "process",
			"group": "build",
            "args": [
                "build",
                "${workspaceFolder}/LenowoTweeks.slnx"
            ],
            "problemMatcher": "$msCompile"
        },
		{
            "label": "build Release",
            "command": "dotnet",
			"group": "build",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/LenowoTweeks.slnx",
                "-c",
                "Release"
            ],
            "problemMatcher": "$msCompile"
        }
	]
}